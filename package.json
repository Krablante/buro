{
  "name": "buro",
  "version": "3.1.0",
  "description": "A CLI and SQLite memory for AI agents: typed records, reviewed YAML changes, and shared context between sessions.",
  "license": "MIT",
  "keywords": [
    "ai-agents",
    "agent-context",
    "context-registry",
    "sqlite",
    "cli",
    "yaml",
    "schema-validation",
    "multi-host",
    "deterministic",
    "agents"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Krablante/buro.git"
  },
  "bugs": {
    "url": "https://github.com/Krablante/buro/issues"
  },
  "homepage": "https://github.com/Krablante/buro#readme",
  "type": "module",
  "engines": {
    "node": ">=24.14"
  },
  "bin": {
    "buro": "src/cli.js"
  },
  "files": [
    "src/",
    "types/",
    "skills/",
    "integrations/",
    "scripts/",
    "docs/",
    "assets/",
    "README.md",
    "README.ru.md"
  ],
  "scripts": {
    "test": "node --test",
    "start": "node src/index.js",
    "demos": "node scripts/generate-demos.mjs",
    "demos:check": "node scripts/generate-demos.mjs --check",
    "deploy:politia": "bash scripts/deploy-live.sh",
    "deploy:live": "bash scripts/deploy-live.sh"
  },
  "dependencies": {
    "js-yaml": "^4.3.2",
    "semver": "^7.8.5"
  }
}
